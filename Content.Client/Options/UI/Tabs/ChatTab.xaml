<tabs:ChatTab xmlns="https://spacestation14.io"
              xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
              xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="10" HorizontalExpand="True">
                <!-- Runechat -->
                <PanelContainer StyleClasses="AshfallPanel" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="4" HorizontalExpand="True">
                        <Label Text="{Loc 'ui-options-chat-runechat'}" StyleClasses="AshfallSectionHeader" />
                        <PanelContainer StyleClasses="LowDivider" MinHeight="1" MaxHeight="1" Margin="0 2 0 6" HorizontalExpand="True" />
                        <ui:OptionCheckBox Name="RunechatSpeechBubblesCheckBox" Title="{Loc 'ui-options-runechat-enable'}" />
                        <ui:OptionSlider Name="RunechatSpeechBubbleScaleSlider" Title="{Loc 'ui-options-runechat-scale'}" />
                    </BoxContainer>
                </PanelContainer>

                <!-- Classic Bubbles -->
                <PanelContainer StyleClasses="AshfallPanel" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="4" HorizontalExpand="True">
                        <Label Text="{Loc 'ui-options-chat-bubbles'}" StyleClasses="AshfallSectionHeader" />
                        <PanelContainer StyleClasses="LowDivider" MinHeight="1" MaxHeight="1" Margin="0 2 0 6" HorizontalExpand="True" />
                        <ui:OptionCheckBox Name="FancySpeechBubblesCheckBox" Title="{Loc 'ui-options-fancy-speech'}" />
                        <ui:OptionCheckBox Name="FancyNameBackgroundsCheckBox" Title="{Loc 'ui-options-fancy-name-background'}" />
                        <ui:OptionCheckBox Name="ShowLoocAboveHeadCheckBox" Title="{Loc 'ui-options-show-looc-on-head'}" />
                    </BoxContainer>
                </PanelContainer>

                <!-- Chat & Log -->
                <PanelContainer StyleClasses="AshfallPanel" HorizontalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="4" HorizontalExpand="True">
                        <Label Text="{Loc 'ui-options-chat-general'}" StyleClasses="AshfallSectionHeader" />
                        <PanelContainer StyleClasses="LowDivider" MinHeight="1" MaxHeight="1" Margin="0 2 0 6" HorizontalExpand="True" />
                        <ui:OptionCheckBox Name="ShowOocPatronColor" Title="{Loc 'ui-options-show-ooc-patron-color'}" />
                        <ui:OptionCheckBox Name="ChatFollowButton" Title="{Loc 'ui-options-chat-follow-button'}" />
                        <ui:OptionCheckBox Name="LogActionsInChatCheckBox" Title="{Loc 'ui-options-log-actions-in-chat'}" />
                        <ui:OptionCheckBox Name="CoalesceIdenticalMessagesCheckBox" Title="{Loc 'ui-options-coalesce-identical-messages'}" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:ChatTab>
