<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Margin="18 14" SeparationOverride="14" HorizontalExpand="True">
                <!-- Volume & Devices -->
                <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                    <Label Text="{Loc 'ui-options-volume-label'}" StyleClasses="AshfallSectionHeader" Margin="0 4 0 2"/>
                    <ui:OptionDropDown Name="DropDownAudioDevice" Title="{Loc 'ui-options-audio-device'}" />
                    <ui:OptionSlider Name="SliderVolumeMaster" Title="{Loc 'ui-options-master-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeMidi" Title="{Loc 'ui-options-midi-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeAmbientMusic" Title="{Loc 'ui-options-ambient-music-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeCombatMusic" Title="{Loc 'ui-options-combat-music-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeAmbience" Title="{Loc 'ui-options-ambience-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeLobby" Title="{Loc 'ui-options-lobby-volume'}" />
                    <ui:OptionSlider Name="SliderVolumeInterface" Title="{Loc 'ui-options-interface-volume'}" />
                    <ui:OptionSlider Name="SliderMaxAmbienceSounds" Title="{Loc 'ui-options-ambience-max-sounds'}" />
                </BoxContainer>

                <!-- Audio Features & Effects -->
                <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                    <Label Text="{Loc 'ui-options-playback-effects-label'}" StyleClasses="AshfallSectionHeader" Margin="0 4 0 2"/>
                    <ui:OptionCheckBox Name="CombatMusicCheckBox" Title="{Loc 'ui-options-combat-music'}" />
                    <ui:OptionCheckBox Name="LobbyMusicCheckBox" Title="{Loc 'ui-options-lobby-music'}" />
                    <ui:OptionCheckBox Name="RestartSoundsCheckBox" Title="{Loc 'ui-options-restart-sounds'}" />
                    <ui:OptionCheckBox Name="EventMusicCheckBox" Title="{Loc 'ui-options-event-music'}" />
                    <ui:OptionCheckBox Name="AdminSoundsCheckBox" Title="{Loc 'ui-options-admin-sounds'}" />
                    <ui:OptionCheckBox Name="BwoinkSoundCheckBox" Title="{Loc 'ui-options-bwoink-sound'}" />
                    <ui:OptionCheckBox Name="AudioHrtfCheckBox" Title="{Loc 'ui-options-audio-hrtf'}" />
                    <ui:OptionCheckBox Name="MuteUnfocusedCheckBox" Title="{Loc 'ui-options-mute-unfocused'}" />
                    <ui:OptionCheckBox Name="SubtleReverbCheckBox" Title="{Loc 'ui-options-subtle-reverb'}" />
                    <ui:OptionCheckBox Name="AudioMuffleCheckBox" Title="{Loc 'ui-options-audio-muffle'}" />
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
