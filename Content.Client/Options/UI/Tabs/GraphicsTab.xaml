<tabs:GraphicsTab xmlns="https://spacestation14.io"
          xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
          xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Margin="18 14" SeparationOverride="14" HorizontalExpand="True">
                <!-- Display -->
                <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                    <Label Text="{Loc 'ui-options-display-label'}" StyleClasses="AshfallSectionHeader" Margin="0 4 0 2"/>
                    <ui:OptionCheckBox Name="FullscreenCheckBox" Title="{Loc 'ui-options-fullscreen'}" />
                    <ui:OptionCheckBox Name="VSyncCheckBox" Title="{Loc 'ui-options-vsync'}" />
                    <BoxContainer Name="MaxFpsContainer"
                                  Orientation="Horizontal"
                                  Margin="0 2"
                                  HorizontalExpand="True"
                                  ToolTip="{Loc 'ui-options-max-fps-tooltip'}">
                        <Label Text="{Loc 'ui-options-max-fps'}" ClipText="True" HorizontalExpand="True" />
                        <BoxContainer Orientation="Horizontal" MinWidth="260" MaxWidth="260" HorizontalAlignment="Right">
                            <ui:OptionIntInput Name="MaxFpsInput" HorizontalExpand="True" />
                            <Button Name="MaxFpsDisplayRateButton"
                                    Text="{Loc 'ui-options-max-fps-display-rate'}"
                                    Margin="8 0 0 0" />
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>

                <!-- Quality -->
                <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                    <Label Text="{Loc 'ui-options-quality-label'}" StyleClasses="AshfallSectionHeader" Margin="0 4 0 2"/>
                    <ui:OptionDropDown Name="DropDownLightingQuality" Title="{Loc 'ui-options-lighting-label'}" />
                    <ui:OptionCheckBox Name="ViewportLowResCheckBox"
                                       Title="{Loc 'ui-options-vp-low-res'}"
                                       ToolTip="{Loc 'ui-options-vp-low-res-tooltip'}" />
                    <ui:OptionCheckBox Name="ParallaxLowQualityCheckBox"
                                       Title="{Loc 'ui-options-parallax-low-quality'}"
                                       ToolTip="{Loc 'ui-options-parallax-low-quality-tooltip'}" />
                    <ui:OptionCheckBox Name="AmbientOcclusionCheckBox"
                                       Title="{Loc 'ui-options-ambient-occlusion'}"
                                       ToolTip="{Loc 'ui-options-ambient-occlusion-tooltip'}" />
                    <ui:OptionSlider Name="SharpnessSlider" Title="{Loc 'ui-options-sharpness'}" />
                </BoxContainer>

                <!-- Interface -->
                <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                    <Label Text="{Loc 'ui-options-interface-label'}" StyleClasses="AshfallSectionHeader" Margin="0 4 0 2"/>
                    <ui:OptionDropDown Name="DropDownUIScale" Title="{Loc 'ui-options-scale-label'}" />
                    <ui:OptionCheckBox Name="ViewportStretchCheckBox"
                                       Title="{Loc 'ui-options-vp-stretch'}"
                                       ToolTip="{Loc 'ui-options-vp-stretch-tooltip'}" />
                    <ui:OptionSlider Name="ViewportScaleSlider" Title="{Loc ui-options-vp-scale}" />
                    <ui:OptionSlider Name="ViewportWidthSlider" Title="{Loc ui-options-vp-width}" />
                    <ui:OptionCheckBox Name="IntegerScalingCheckBox"
                                       Title="{Loc 'ui-options-vp-integer-scaling'}"
                                       ToolTip="{Loc 'ui-options-vp-integer-scaling-tooltip'}" />
                    <ui:OptionDropDown Name="DropDownFilterMode" Title="{Loc 'ui-options-filter-label'}" />
                    <ui:OptionCheckBox Name="ViewportVerticalFitCheckBox"
                                       Title="{Loc 'ui-options-vp-vertical-fit'}"
                                       ToolTip="{Loc 'ui-options-vp-vertical-fit-tooltip'}" />
                </BoxContainer>

                <!-- Misc -->
                <BoxContainer Orientation="Vertical" SeparationOverride="3" HorizontalExpand="True">
                    <Label Text="{Loc 'ui-options-misc-label'}" StyleClasses="AshfallSectionHeader" Margin="0 4 0 2"/>
                    <ui:OptionCheckBox Name="FpsCounterCheckBox" Title="{Loc 'ui-options-fps-counter'}" />
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:GraphicsTab>
