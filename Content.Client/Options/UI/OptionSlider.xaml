<Control xmlns="https://spacestation14.io" HorizontalExpand="True">
    <PanelContainer Name="RowPanel" HorizontalExpand="True" MouseFilter="Pass">
        <BoxContainer Orientation="Vertical" Margin="8 4" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Name="NameLabel" ClipText="True" HorizontalExpand="True" VerticalAlignment="Center" />
                <BoxContainer Orientation="Horizontal" MinWidth="260" MaxWidth="260" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Slider Name="Slider" Access="Public" HorizontalExpand="True" VerticalAlignment="Center" />
                    <Label Name="ValueLabel" Access="Public" Margin="8 0 0 0" MinWidth="44" Align="Right" VerticalAlignment="Center" />
                </BoxContainer>
            </BoxContainer>
            <Label Name="DescriptionLabel" Visible="False" Margin="0 4 0 0" ClipText="False" FontColorOverride="#A0ADB8" />
        </BoxContainer>
    </PanelContainer>
</Control>
